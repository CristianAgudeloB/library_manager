<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lector: <%= comic.title %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.png" />
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #121212;
      font-family: "Poppins", sans-serif;
    }

    .reader-header {
      background-color: #333;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 10;
      transition: top 0.3s ease;
      gap: 15px;
      flex-wrap: wrap;
    }

    .header-middle {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      min-width: 250px;
      justify-content: center;
    }

    .reader-header.hidden {
      top: -70px;
    }

    .reader-header .header-logo img {
      height: 50px;
      width: auto;
    }

    .reader-header .comic-title {
      color: #fff;
      font-size: 24px;
      font-weight: bold;
      margin: 0 20px;
    }

    .reader-header .zoom-controls {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .reader-header .zoom-controls select,
    .reader-header .zoom-controls input {
      padding: 5px;
      font-size: 16px;
      border-radius: 5px;
      border: 1px solid #1e1e1e;
      background-color: #1e1e1e;
      color: #fff;
      font-family: "Poppins", sans-serif;
    }

    .reader-header .zoom-controls input {
      width: 60px;
      text-align: right;
    }

    .mode-toggle {
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      padding: 8px 12px;
      border-radius: 5px;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
    }

    .mode-toggle i {
      transition: transform 0.3s ease;
    }

    .mode-toggle:hover {
      background-color: rgba(255, 255, 255, 0.1);
    }

    @media (max-width: 768px) {
      .header-logo {
        display: none;
      }

      .reader-header {
        padding: 10px;
        gap: 10px;
      }

      .header-middle {
        min-width: auto;
        order: -1;
        width: 100%;
        justify-content: space-between;
      }

      .reader-header .comic-title {
        font-size: 18px;
        margin: 0 10px;
      }

      .reader-header .zoom-controls select,
      .reader-header .zoom-controls input {
        font-size: 14px;
        padding: 3px;
      }

      .reader-header .zoom-controls input {
        width: 50px;
      }

      .mode-toggle {
        padding: 6px 10px;
        font-size: 18px;
      }
    }

    @media (max-width: 480px) {
      .comic-title {
        font-size: 16px;
        max-width: 60vw;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .mode-toggle i {
        font-size: 1.2em;
      }
    }

    .comic-reader {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      min-height: calc(100vh - 70px);
      padding-top: 20px;
      position: relative;
    }

    @media (max-width: 768px) {
      .comic-reader {
        padding-top: 10px;
        min-height: calc(100vh - 60px);
      }
    }

    .comic-reader .current-page {
      max-width: 90%;
      max-height: none;
      object-fit: contain;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease;
      transform-origin: top center;
      padding-bottom: 50px;
    }

    .cascade-mode .zoom-controls {
      display: none !important;
    }

    .comic-reader .nav-button {
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      background-color: rgba(0, 0, 0, 0.5);
      color: #fff;
      border: none;
      border-radius: 50%;
      width: 50px;
      height: 50px;
      font-size: 24px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.3s ease;
      z-index: 20;
    }

    .comic-reader .nav-button:hover {
      background-color: rgba(0, 0, 0, 0.8);
    }

    .comic-reader .nav-button.prev {
      left: 20px;
    }

    .comic-reader .nav-button.next {
      right: 20px;
    }

    .page-index {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      background-color: rgba(0, 0, 0, 0.7);
      color: #fff;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 14px;
      font-family: "Poppins", sans-serif;
      z-index: 1000;
      opacity: 0;
      transition: opacity 0.5s ease;
    }

    .page-index.visible {
      opacity: 1;
    }

    .cascade-mode .nav-button {
      display: none !important;
    }

    .cascade-mode .comic-reader {
      flex-direction: column;
      align-items: center;
      overflow-y: auto;
    }

    .cascade-mode .comic-reader img {
      margin: 10px 0;
      max-width: 100%;
      transform: none !important;
    }

    .cascade-page {
      width: 100%;
      max-width: 900px !important;
      margin: 0 auto 20px;
      display: block !important;
    }
  </style>
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2746195589471117"
      crossorigin="anonymous"></script>
</head>

<body>
  <header class="reader-header">
    <div class="header-logo">
      <a href="/">
        <img src="/images/logo.png" alt="Logo de la Biblioteca de Cómics" />
      </a>
    </div>
    <div class="header-middle">
      <div class="comic-title"><%= comic.title %></div>
      <button id="mode-toggle" class="mode-toggle" onclick="toggleReadMode()" title="Cambiar modo de lectura">
        <i class="fas fa-arrows-alt-v"></i>
      </button>
    </div>
    <div class="zoom-controls">
      <select id="zoom-select" onchange="handleZoomSelect(this.value)">
        <option value="100">100%</option>
        <option value="125">125%</option>
        <option value="150">150%</option>
        <option value="175">175%</option>
        <option value="200">200%</option>
        <option value="custom">Personalizado</option>
      </select>
      <div id="custom-zoom-container" style="display: none">
        <input type="text" id="custom-zoom" placeholder="Ej: 120" onchange="applyCustomZoom(this.value)" />
        <span>%</span>
      </div>
    </div>
  </header>

  <div id="page-index" class="page-index">
    <span id="current-page-index">1</span>/<span id="total-pages"><%= comic.pages.length %></span>
  </div>

  <main class="comic-reader">
    <button class="nav-button prev" onclick="prevPage()">&#10094;</button>
    <img id="current-page" src="<%= comic.pages[0] %>" alt="Página del cómic" class="current-page" />
    <button class="nav-button next" onclick="nextPage()">&#10095;</button>
  </main>

  <script>
    const pages = <%- JSON.stringify(comic.pages).replace(/</g, '\\u003c') %>;
    let currentIndex = 0;
    let currentZoom = 100;
    let lastScrollTop = 0;
    let isCascadeMode = false;

    const pageIndex = document.getElementById('page-index');
    const currentPageIndex = document.getElementById('current-page-index');
    const totalPages = document.getElementById('total-pages');

    function toggleReadMode() {
      isCascadeMode = !isCascadeMode;
      const body = document.body;
      const toggleIcon = document.querySelector('#mode-toggle i');
      
      if (isCascadeMode) {
        body.classList.add('cascade-mode');
        toggleIcon.classList.remove('fa-arrows-alt-v');
        toggleIcon.classList.add('fa-arrows-alt-h');
        const reader = document.querySelector('.comic-reader');
        reader.innerHTML = pages.map(page => `
          <img src="${page}" class="current-page cascade-page" />
        `).join('');
      } else {
        body.classList.remove('cascade-mode');
        toggleIcon.classList.remove('fa-arrows-alt-h');
        toggleIcon.classList.add('fa-arrows-alt-v');
        const reader = document.querySelector('.comic-reader');
        reader.innerHTML = `
          <button class="nav-button prev" onclick="prevPage()">&#10094;</button>
          <img id="current-page" src="${pages[currentIndex]}" class="current-page" />
          <button class="nav-button next" onclick="nextPage()">&#10095;</button>
        `;
        applyZoom(currentZoom);
      }
    }

    function showPage(index) {
      if (isCascadeMode) return;
      if (index >= 0 && index < pages.length) {
        const img = document.getElementById('current-page');
        img.src = pages[index];
        applyZoom(currentZoom);
        currentIndex = index;

        currentPageIndex.textContent = currentIndex + 1;
        pageIndex.classList.add('visible');

        setTimeout(() => {
          pageIndex.classList.remove('visible');
        }, 2000);

        const prevButton = document.querySelector('.nav-button.prev');
        const nextButton = document.querySelector('.nav-button.next');
        prevButton.style.display = currentIndex === 0 ? 'none' : 'flex';
        nextButton.style.display = currentIndex === pages.length - 1 ? 'none' : 'flex';

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function prevPage() {
      if (currentIndex > 0) {
        showPage(currentIndex - 1);
      }
    }

    function nextPage() {
      if (currentIndex < pages.length - 1) {
        showPage(currentIndex + 1);
      }
    }

    function applyZoom(zoom) {
      const img = document.getElementById('current-page');
      currentZoom = parseInt(zoom, 10);
      img.style.transform = `scale(${currentZoom / 100})`;
      document.getElementById('custom-zoom').value = currentZoom;

      if (document.getElementById('custom-zoom-container').style.display === 'flex') {
        document.getElementById('zoom-select').value = 'custom';
      } else {
        document.getElementById('zoom-select').value = currentZoom;
      }
    }

    function applyCustomZoom(zoom) {
      const zoomValue = parseInt(zoom, 10);
      if (!isNaN(zoomValue) && zoomValue >= 0) {
        applyZoom(zoomValue);
        document.getElementById('zoom-select').value = 'custom';
      }
    }

    function handleZoomSelect(value) {
      const customZoomContainer = document.getElementById('custom-zoom-container');
      if (value === 'custom') {
        customZoomContainer.style.display = 'flex';
      } else {
        customZoomContainer.style.display = 'none';
        applyZoom(value);
      }
    }

    document.addEventListener('keydown', (event) => {
      if (isCascadeMode) return;
      if (event.key === 'ArrowLeft') {
        prevPage();
      } else if (event.key === 'ArrowRight') {
        nextPage();
      }
    });

    document.addEventListener('scroll', () => {
      const header = document.querySelector('.reader-header');
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (scrollTop > lastScrollTop) {
        header.classList.add('hidden');
      } else {
        header.classList.remove('hidden');
      }

      lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
    });

    showPage(currentIndex);
  </script>
</body>
</html>