<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= comic.title %></title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.png">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Menú superior -->
    <header>
        <div class="header-logo">
            <a href="/">
                <img src="/images/logo.png" alt="Logo de la Biblioteca de Cómics">
            </a>
        </div>
        <nav class="menu">
            <ul>
                <li><a href="/">Inicio</a></li>
                <li><a href="/marvel">Marvel</a></li>
                <li><a href="/dc">DC</a></li>
                <li><a href="/indie">Indie</a></li>
                <li><a href="/novedades">Novedades</a></li>
                <li><a href="/el-corps">El Corps</a></li>
            </ul>
            <!-- Barra de búsqueda -->
            <div class="search-container">
                <div class="search-icon" onclick="toggleSearch()">
                    <img src="/images/lupa.png" alt="Buscar">
                </div>
                <form action="/buscar" method="GET" class="search-form">
                    <input type="text" name="q" placeholder="Buscar por título o volumen..." required>
                    <button type="submit">Buscar</button>
                </form>
            </div>
        </nav>
    </header>

    <!-- Contenido principal -->
    <main class="comic-detail">
        <!-- Sección izquierda: Imagen y título -->
        <div class="comic-left">
            <img src="<%= comic.coverUrl %>" alt="<%= comic.title %>">
            <h2><%= comic.title %></h2>
        </div>

        <!-- Sección derecha: Información adicional -->
        <div class="comic-right">
            <!-- Caja de descripción y equipo de tradumaqueta -->
            <div class="info-box">
                <h3>Descripción</h3>
                <p><%= comic.descripcion %></p>
                <div class="team-info">
                    <p><strong>Traductor:</strong> <%= comic.traductor %></p>
                    <p><strong>Maqueta:</strong> <%= comic.maqueta %></p>
                    <p><strong>Corrector:</strong> <%= comic.corrector %></p>
                </div>
            </div>

            <!-- Caja de enlaces de descarga -->
            <div class="info-box">
                <h3>Enlaces de descarga</h3>
                <ul>
                    <% comic.downloadUrls.forEach(url => { %>
                        <li>
                            <a href="<%= url %>" target="_blank">
                                Descargar (<%= url.includes('mega') ? 'Mega' : url.includes('mediafire') ? 'Mediafire' : 'Enlace' %>)
                            </a>
                        </li>
                    <% }) %>
                </ul>
            </div>
        </div>
    </main>
    <!-- Sección de cómics relacionados -->
    <section class="related-comics">
        <h2>Cómics relacionados</h2>
        <div class="comics-grid">
            <% if (relacionados.length > 0) { %>
                <% relacionados.forEach(comic => { %>
                    <div class="comic-card">
                        <a href="/comic/<%= comic._id %>">
                            <img src="<%= comic.coverUrl %>" alt="<%= comic.title %>">
                            <h3><%= comic.title %></h3>
                            <p><%= comic.volume %></p>
                        </a>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No hay cómics relacionados.</p>
            <% } %>
        </div>
    </section>

    <footer>
        <p>Inifinity Comics 2025 - Sin ánimo de lucro. Todos los derechos reservados a sus respectivos creadores y propietarios.</p>
        <p>Creado por Mastercraft Web Developing</p>
    </footer>

    <!-- Script para mostrar/ocultar la barra de búsqueda -->
    <script>
        function toggleSearch() {
            const searchForm = document.querySelector('.search-form');
            searchForm.classList.toggle('active');
        }
    </script>
</body>
</html>
</body>
</html>