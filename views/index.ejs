<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Infinity Comics</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.png" />
    <link rel="stylesheet" href="/styles.css" />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"
    />
  </head>
  <body>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

    <header>
      <div class="header-logo">
        <a href="/">
          <img src="/images/logo.png" alt="Logo de la Biblioteca de Cómics" />
        </a>
      </div>
      <div class="menu-toggle">&#9776;</div>
      <nav class="menu">
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/marvel">Marvel</a></li>
          <li><a href="/dc">DC</a></li>
          <li><a href="/indie">Indie</a></li>
          <li><a href="/novedades">Novedades</a></li>
          <li><a href="/el-corps">El Corps</a></li>
        </ul>
        <div class="search-container">
          <div class="search-icon" onclick="toggleSearch()">
            <img src="/images/lupa.png" alt="Buscar" />
          </div>
          <form action="/buscar" method="GET" class="search-form">
            <input
              type="text"
              name="q"
              placeholder="Buscar por título o volumen..."
              required
            />
            <button type="submit">Buscar</button>
          </form>
        </div>
      </nav>
    </header>

    <main>
      <% if (isHome) { %>
      <section>
        <h2>Destacados</h2>
        <div class="comics-slider">
          <% if (destacados.length > 0) { %> <% destacados.slice(0,
          12).forEach(comic => { %>
          <div class="comic-slide">
            <div class="comic-card">
              <a href="/comic/<%= comic._id %>">
                <img src="<%= comic.coverUrl %>" alt="<%= comic.title %>" />
                <h3><%= comic.title %></h3>
                <p>
                  <a href="/series/<%= comic.volume %>" class="series-link"
                    ><%= comic.volume %></a
                  >
                </p>
              </a>
            </div>
          </div>
          <% }) %> <% } else { %>
          <p>No hay cómics destacados.</p>
          <% } %>
        </div>
      </section>

      <section>
        <h2>Marvel</h2>
        <div class="comics-slider">
          <% if (marvel.length > 0) { %> <% marvel.slice(0, 12).forEach(comic =>
          { %>
          <div class="comic-slide">
            <div class="comic-card">
              <a href="/comic/<%= comic._id %>">
                <img src="<%= comic.coverUrl %>" alt="<%= comic.title %>" />
                <h3><%= comic.title %></h3>
                <p>
                  <a href="/series/<%= comic.volume %>" class="series-link"
                    ><%= comic.volume %></a
                  >
                </p>
              </a>
            </div>
          </div>
          <% }) %> <% } else { %>
          <p>No hay cómics de Marvel.</p>
          <% } %>
        </div>
      </section>

      <section>
        <h2>DC</h2>
        <div class="comics-slider">
          <% if (dc.length > 0) { %> <% dc.slice(0, 12).forEach(comic => { %>
          <div class="comic-slide">
            <div class="comic-card">
              <a href="/comic/<%= comic._id %>">
                <img src="<%= comic.coverUrl %>" alt="<%= comic.title %>" />
                <h3><%= comic.title %></h3>
                <p>
                  <a href="/series/<%= comic.volume %>" class="series-link"
                    ><%= comic.volume %></a
                  >
                </p>
              </a>
            </div>
          </div>
          <% }) %> <% } else { %>
          <p>No hay cómics de DC.</p>
          <% } %>
        </div>
      </section>

      <section>
        <h2>Indie</h2>
        <div class="comics-slider">
          <% if (indie.length > 0) { %> <% indie.slice(0, 12).forEach(comic => {
          %>
          <div class="comic-slide">
            <div class="comic-card">
              <a href="/comic/<%= comic._id %>">
                <img src="<%= comic.coverUrl %>" alt="<%= comic.title %>" />
                <h3><%= comic.title %></h3>
                <p>
                  <a href="/series/<%= comic.volume %>" class="series-link"
                    ><%= comic.volume %></a
                  >
                </p>
              </a>
            </div>
          </div>
          <% }) %> <% } else { %>
          <p>No hay cómics independientes.</p>
          <% } %>
        </div>
      </section>
      <% } else { %>
      <section>
        <h2><%= category || "Resultados de búsqueda" %></h2>
        <div class="comics-grid">
          <% if (comics.length > 0) { %> <% comics.forEach(comic => { %>
          <div class="comic-card">
            <a href="/comic/<%= comic._id %>">
              <img src="<%= comic.coverUrl %>" alt="<%= comic.title %>" />
              <h3><%= comic.title %></h3>
              <p>
                <a href="/series/<%= comic.volume %>" class="series-link"
                  ><%= comic.volume %></a
                >
              </p>
            </a>
          </div>
          <% }) %> <% } else { %>
          <p>No se encontraron cómics.</p>
          <% } %>
        </div>
      </section>
      <% } %>
    </main>

    <footer>
      <p>
        Inifinity Comics 2025 - Sin ánimo de lucro. Todos los derechos
        reservados a sus respectivos creadores y propietarios.
      </p>
      <p>Web desarrollada por Absolute</p>
    </footer>

    <script>
      function toggleSearch() {
        const searchForm = document.querySelector(".search-form");
        searchForm.classList.toggle("active");
      }

      document
        .querySelector(".menu-toggle")
        .addEventListener("click", function () {
          const menu = document.querySelector(".menu ul");
          menu.classList.toggle("active");
        });

      $(document).ready(function () {
        $(".comics-slider").slick({
          infinite: true,
          slidesToShow: 5,
          slidesToScroll: 1,
          arrows: true,
          dots: false,
          prevArrow: '<button type="button" class="slick-prev">←</button>',
          nextArrow: '<button type="button" class="slick-next">→</button>',
          responsive: [
            {
              breakpoint: 1280,
              settings: {
                slidesToShow: 4,
                slidesToScroll: 1,
              },
            },
            {
              breakpoint: 1024,
              settings: {
                slidesToShow: 3,
                slidesToScroll: 1,
                centerMode: true,
                centerPadding: "20px",
              },
            },
            {
              breakpoint: 900,
              settings: {
                slidesToShow: 3,
                slidesToScroll: 1,
                centerMode: false,
              },
            },
            {
              breakpoint: 820,
              settings: {
                slidesToShow: 3,
                slidesToScroll: 1,
                centerMode: true,
                centerPadding: "10px",
              },
            },
            {
              breakpoint: 768,
              settings: {
                slidesToShow: 3,
                slidesToScroll: 1,
                centerMode: false,
              },
            },
            {
              breakpoint: 480,
              settings: {
                slidesToShow: 2,
                slidesToScroll: 1,
                centerMode: false,
              },
            },
            {
              breakpoint: 360,
              settings: {
                slidesToShow: 1,
                slidesToScroll: 1,
              },
            },
          ],
        });
      });
    </script>
  </body>
</html>
