<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Infinity Comics - <%= editorial %></title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.png" />
    <link rel="stylesheet" href="/styles.css" />
    <!-- Aquí puedes agregar enlaces a fuentes o cualquier otro recurso -->
  </head>
  <body>
    <!-- Menú superior -->
    <header>
      <div class="header-logo">
        <a href="/"><img src="/images/logo.png" alt="Logo de Infinity Comics" /></a>
      </div>
      <div class="menu-toggle">&#9776;</div>
      <nav class="menu">
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/marvel">Marvel</a></li>
          <li><a href="/dc">DC</a></li>
          <li><a href="/indie">Indie</a></li>
          <li><a href="/novedades">Novedades</a></li>
          <li><a href="/el-corps">El Corps</a></li>
          <!-- Otros enlaces si los hubiera -->
        </ul>
        <!-- Barra de búsqueda -->
        <div class="search-container">
          <div class="search-icon" onclick="toggleSearch()">
            <img src="/images/lupa.png" alt="Buscar" />
          </div>
          <form action="/buscar" method="GET" class="search-form">
            <input type="text" name="q" placeholder="Buscar por título o volumen..." required />
            <button type="submit">Buscar</button>
          </form>
        </div>
      </nav>
    </header>

    <!-- Contenido principal -->
    <main>
      <section>
        <h2>Cómics de <%= editorial %></h2>
        <div class="comics-grid">
          <% if (comics && comics.length > 0) { %>
            <% comics.forEach(comic => { %>
              <div class="comic-card">
                <a href="/comic/<%= comic._id %>">
                  <img src="<%= comic.coverUrl %>" alt="<%= comic.title %>" />
                  <h3><%= comic.title %></h3>
                  <p>
                    <a href="/series/<%= comic.volume %>" class="series-link">
                      <%= comic.volume %>
                    </a>
                  </p>
                </a>
              </div>
            <% }); %>
          <% } else { %>
            <p>No se encontraron cómics para esta editorial.</p>
          <% } %>
        </div>
      </section>

      <div class="pagination">
        <!-- Botón Anterior -->
        <% if (currentPage > 1) { %>
          <a class="pagination-link" href="/<%= editorial.toLowerCase() %>?page=<%= currentPage - 1 %>">&laquo;</a>
        <% } else { %>
          <span class="pagination-link disabled">&laquo;</span>
        <% } %>
      
        <% 
          // Configuración de la ventana de páginas visibles
          const maxVisible = 5; // Número máximo de enlaces intermedios a mostrar
          let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
          let endPage = startPage + maxVisible - 1;
          if (endPage > totalPages) {
            endPage = totalPages;
            startPage = Math.max(1, endPage - maxVisible + 1);
          }
        %>
      
        <!-- Si no se muestra la primera página, la mostramos y añadimos puntos suspensivos -->
        <% if (startPage > 1) { %>
          <a class="pagination-link" href="/<%= editorial.toLowerCase() %>?page=1">1</a>
          <% if (startPage > 2) { %>
            <span class="pagination-ellipsis">...</span>
          <% } %>
        <% } %>
      
        <!-- Enlaces de páginas intermedias -->
        <% for (let i = startPage; i <= endPage; i++) { %>
          <% if (i === currentPage) { %>
            <span class="pagination-link current"><%= i %></span>
          <% } else { %>
            <a class="pagination-link" href="/<%= editorial.toLowerCase() %>?page=<%= i %>"><%= i %></a>
          <% } %>
        <% } %>
      
        <!-- Si no se muestra la última página, la mostramos con puntos suspensivos -->
        <% if (endPage < totalPages) { %>
          <% if (endPage < totalPages - 1) { %>
            <span class="pagination-ellipsis">...</span>
          <% } %>
          <a class="pagination-link" href="/<%= editorial.toLowerCase() %>?page=<%= totalPages %>"><%= totalPages %></a>
        <% } %>
      
        <!-- Botón Siguiente -->
        <% if (currentPage < totalPages) { %>
          <a class="pagination-link" href="/<%= editorial.toLowerCase() %>?page=<%= currentPage + 1 %>">&raquo;</a>
        <% } else { %>
          <span class="pagination-link disabled">&raquo;</span>
        <% } %>
      </div>      
    </main>

    <!-- Pie de página -->
    <footer>
      <p>Infinity Comics 2025 - Sin ánimo de lucro. Todos los derechos reservados a sus respectivos creadores y propietarios.</p>
      <p>Creado por Mastercraft Web Developing</p>
    </footer>

    <!-- Scripts -->
    <script src="/js/main.js"></script>
    <script>
      function toggleSearch() {
        const searchForm = document.querySelector(".search-form");
        searchForm.classList.toggle("active");
      }
      // Activar menú hamburguesa si es necesario
      document.querySelector('.menu-toggle')?.addEventListener('click', function () {
        const menu = document.querySelector('.menu ul');
        menu.classList.toggle('active');
      });
    </script>
  </body>
</html>
