<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Infinity Comics - <%= editorial %></title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.png" />
    <link rel="stylesheet" href="/styles.css" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2746195589471117"
     crossorigin="anonymous"></script>
  </head>
  <body>
    <header>
      <div class="header-logo">
        <a href="/"
          ><img src="/images/logo.png" alt="Logo de Infinity Comics"
        /></a>
      </div>
      <div class="menu-toggle">&#9776;</div>
      <nav class="menu">
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/marvel">Marvel</a></li>
          <li><a href="/dc">DC</a></li>
          <li><a href="/indie">Indie</a></li>
          <li><a href="/novedades">Novedades</a></li>
          <li><a href="/el-corps">El Corps</a></li>
        </ul>
        <div class="search-container">
          <div class="search-icon" onclick="toggleSearch()">
            <img src="/images/lupa.png" alt="Buscar" />
          </div>
          <form action="/buscar" method="GET" class="search-form">
            <input
              type="text"
              name="q"
              placeholder="Buscar por título o volumen..."
              required
            />
            <button type="submit">Buscar</button>
          </form>
        </div>
      </nav>
    </header>

    <main>
      <section>
        <h2>Series <%= editorial %></h2>
        <div class="comics-grid">
          <% if (comics && comics.length > 0) { %> <% comics.forEach(comic => {
          %>
          <div class="comic-card">
            <a href="/series/<%= comic.volume %>">
              <img src="<%= comic.coverUrl %>" alt="<%= comic.title %>" />
              <h3><%= comic.volume %></h3>
            </a>
          </div>
          <% }); %> <% } else { %>
          <p>No se encontraron cómics para esta editorial.</p>
          <% } %>
        </div>
      </section>

      <div class="pagination">
        <% if (currentPage > 1) { %>
        <a
          class="pagination-link"
          href="/<%= editorial.toLowerCase() %>?page=<%= currentPage - 1 %>"
          >&laquo;</a
        >
        <% } else { %>
        <span class="pagination-link disabled">&laquo;</span>
        <% } %> <% const maxVisible = 5; let startPage = Math.max(1, currentPage
        - Math.floor(maxVisible / 2)); let endPage = startPage + maxVisible - 1;
        if (endPage > totalPages) { endPage = totalPages; startPage =
        Math.max(1, endPage - maxVisible + 1); } %> <% if (startPage > 1) { %>
        <a class="pagination-link" href="/<%= editorial.toLowerCase() %>?page=1"
          >1</a
        >
        <% if (startPage > 2) { %>
        <span class="pagination-ellipsis">...</span>
        <% } %> <% } %> <% for (let i = startPage; i <= endPage; i++) { %> <% if
        (i === currentPage) { %>
        <span class="pagination-link current"><%= i %></span>
        <% } else { %>
        <a
          class="pagination-link"
          href="/<%= editorial.toLowerCase() %>?page=<%= i %>"
          ><%= i %></a
        >
        <% } %> <% } %> <% if (endPage < totalPages) { %> <% if (endPage <
        totalPages - 1) { %>
        <span class="pagination-ellipsis">...</span>
        <% } %>
        <a
          class="pagination-link"
          href="/<%= editorial.toLowerCase() %>?page=<%= totalPages %>"
          ><%= totalPages %></a
        >
        <% } %> <% if (currentPage < totalPages) { %>
        <a
          class="pagination-link"
          href="/<%= editorial.toLowerCase() %>?page=<%= currentPage + 1 %>"
          >&raquo;</a
        >
        <% } else { %>
        <span class="pagination-link disabled">&raquo;</span>
        <% } %>
      </div>
    </main>

    <footer>
      <p>
        Infinity Comics 2025 - Sin ánimo de lucro. Todos los derechos reservados
        a sus respectivos creadores y propietarios.
      </p>
      <p>Web desarrollada por Absolute</p>
    </footer>

    <script>
      function toggleSearch() {
        const searchForm = document.querySelector(".search-form");
        searchForm.classList.toggle("active");
      }
      document
        .querySelector(".menu-toggle")
        ?.addEventListener("click", function () {
          const menu = document.querySelector(".menu ul");
          menu.classList.toggle("active");
        });
    </script>
  </body>
</html>
